# Copy this file to .env and edit values as needed.
# Example:
# DATASET_NAME=my_dataset
# WEB_PORT=8092

# Name of the dataset (optional).
DATASET_NAME=

# Host port to expose the SAM2 web UI (default 8092)
WEB_PORT=8092

# Optionally set the host UID/GID to run containers with matching ownership.
# Default is 1000:1000 which matches the container user created in the image.
HOST_UID=1000
HOST_GID=1000

# HESTIA backend credentials (for vm_comms worker poller and UI)
HESTIA_API_KEY=
HESTIA_API_URL=https://api.textailes.athenarc.gr

# Host mount points for worker_poller (REQUIRED — worker_poller runs on host, not in container)
# Set these to the actual host paths where SAM2 input/output dirs live
IN_MNT=/opt/samplify_sugar/SAM2/data/input
OUT=/opt/samplify_sugar/SAM2/data/output
