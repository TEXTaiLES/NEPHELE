# Environment file for worker_poller.service.
# Copy to worker_poller.env and edit. Keep perms tight: chmod 600.

# --- HESTIA --------------------------------------------------------------
# Reachable from the SAM VM over the LAN.
HESTIA_API_URL=http://machine-a:5000
HESTIA_API_KEY=change-me-locally

# Override only if MinIO is exposed on a different host than the API.
# Default behaviour rewrites the public_url host to match HESTIA_API_URL :9000.
# HESTIA_MINIO_URL=http://machine-a:9000

# --- Dispatch mode -------------------------------------------------------
# Leave blank or unset for polling mode (worker hits POST /vm-comms/claim).
# Set to <host>:29092 to switch to Kafka mode (subscribes to nefele_job_created).
# KAFKA_BROKER=machine-a:29092

# Polling-mode interval (seconds). Ignored in Kafka mode.
VM_COMMS_POLL_INTERVAL=5

# --- Optional overrides (defaults baked into the unit are usually fine) -
# IN_MNT=/opt/samplify_sugar/SAM2/data/input
# OUT=/opt/samplify_sugar/SAM2/data/output
# INDEX_SUFFIX=_indexed
# PIPELINE_SCRIPT=/opt/samplify_sugar/scripts/run_pipeline.sh
# COMPOSE_DIR=/opt/samplify_sugar
# SAM2_SERVICE=sam2
