# Copy this file to .env and edit values as needed.

# Name of the dataset (optional — leave empty to start in /setup mode).
DATASET_NAME=

# Host port to expose the Nefele UI (container listens on 5000).
WEB_PORT=8092

# Host UID/GID to run the container as (match the owner of ./data).
HOST_UID=1000
HOST_GID=1000

# Path to the samplify_sugar checkout on the host. Only matters for the
# shared_fs mode bind mounts in docker-compose.yml; in vm_comms mode the UI
# never reads those paths and you can leave this at the default.
SAMPLIFY_ROOT=/home/vaia/samplify_sugar

# UI <-> worker transport:
#   shared_fs — legacy: direct HTTP to WORKER_URL + shared /data volumes
#   vm_comms  — decoupled: messages routed through the HESTIA vm-comms API
COMMS_BACKEND=shared_fs
VM_COMMS_POLL_INTERVAL=2

# SAM2 worker — reachable HTTP endpoint. Used only when COMMS_BACKEND=shared_fs.
WORKER_URL=http://sam2:5001
WORKER_TIMEOUT=600

# HESTIA API — used for scan browsing and reconstruction upload.
HESTIA_API_URL=http://api.textailes.athenarc.gr
HESTIA_API_KEY=

# Optional: MinIO override if image download URLs need rewriting.
# HESTIA_MINIO_URL=

# Directus SSO. The UI sits under .textailes.athenarc.gr and shares the
# refresh-token cookie with Directus; on every request the gate exchanges it
# for a fresh access token via DIRECTUS_URL/auth/refresh. Disabled by default
# so the UI works on naked IPs / dev hosts where the cookie can't be shared.
AUTH_ENABLED=0
DIRECTUS_URL=https://textailes.athenarc.gr
# Optional overrides — defaults below are computed from DIRECTUS_URL.
# DIRECTUS_LOGIN_URL=https://textailes.athenarc.gr/archive/user/login
# Public URL of this UI (the one users type into the browser). Directus
# bounces them here after login, so this MUST be reachable from outside.
APP_BASE=http://nephele.textailes.athenarc.gr:8093
# Cookie that Directus sets. Domain must match the suffix Directus issues on.
AUTH_COOKIE_NAME=textailes_refresh_token
AUTH_COOKIE_DOMAIN=.textailes.athenarc.gr
# SECRET_KEY=
