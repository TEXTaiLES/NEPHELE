# CPU-only image for the Point Picker Flask UI.
# Talks to the SAM2 worker over HTTP — no torch/CUDA needed.
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    IN_MNT=/data/in \
    OUT_MNT=/data/out

RUN apt-get update && apt-get install -y --no-install-recommends \
      tini ca-certificates curl procps \
      libjpeg62-turbo zlib1g \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      flask==3.0.3 \
      pillow \
      python-dotenv \
      requests \
      flask-login

ARG UID=1000
ARG GID=1000
ARG UNAME=user
RUN groupadd -g ${GID} ${UNAME} || true \
 && useradd -m -u ${UID} -g ${GID} -s /bin/bash ${UNAME}
RUN mkdir -p /workspace ${IN_MNT} ${OUT_MNT} \
 && chown -R ${UID}:${GID} /workspace ${IN_MNT} ${OUT_MNT}

USER ${UID}:${GID}
WORKDIR /workspace

ENTRYPOINT ["tini", "--"]
CMD ["python3", "-u", "-m", "app.wsgi"]
